<?xml version="1.0" encoding="UTF-8"?>

<!-- Import JavaFX UI components -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Main layout container (BorderPane = top, center, bottom, left, right) -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.TechDashboardController" <!-- Controller class -->
            style="-fx-font-size: 13px;"> <!-- Default font size -->

    <!-- TOP BAR -->
    <top>
        <HBox style="-fx-background-color:#2c3e50; -fx-padding:10;">
            
            <!-- Welcome label (dynamic text from controller) -->
            <Label fx:id="welcomeLabel"
                   style="-fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;"/>
            
            <!-- Spacer to push logout button to right -->
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Logout button -->
            <Button text="Logout"
                    onAction="#handleLogout" <!-- Calls controller method -->
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>
        </HBox>
    </top>

    <!--CENTER CONTENT -->
    <center>
        
        <!-- TabPane (multiple tabs UI) -->
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-padding:8;">

            <!-- TAB 1: RECORD ATTENDANCE -->
            <Tab text="Record Attendance">
                <VBox spacing="10" style="-fx-padding:15;">
                    
                    <!-- Title -->
                    <Label text="Record Attendance"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                    <!-- Form layout -->
                    <GridPane hgap="10" vgap="8">

                        <!-- Student selection -->
                        <Label text="Student:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="studentCombo" prefWidth="160"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <!-- Course selection -->
                        <Label text="Course:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="courseCombo" prefWidth="130"
                                  GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <!-- Attendance type -->
                        <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="typeCombo" prefWidth="130"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <!-- Session number -->
                        <Label text="Session #:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="sessionCombo" prefWidth="80"
                                  GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <!-- Date -->
                        <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <DatePicker fx:id="sessionDatePicker"
                                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <!-- Present checkbox -->
                        <Label text="Present:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <CheckBox fx:id="presentCheck" selected="true"
                                  GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                    </GridPane>

                    <!-- Save button -->
                    <HBox spacing="10">
                        <Button text="Save Attendance"
                                onAction="#handleSaveAttendance"
                                style="-fx-background-color:#27ae60; -fx-text-fill:white;"/>
                    </HBox>

                    <!-- Status message -->
                    <Label fx:id="attStatusLabel"/>

                    <Separator/>

                    <!-- Summary buttons -->
                    <Label text="View Summary" style="-fx-font-weight:bold;"/>
                    <HBox spacing="10">
                        <Button text="View Batch Summary"
                                onAction="#handleViewBatchSummary"/>
                        <Button text="View Individual Summary"
                                onAction="#handleViewIndividualSummary"/>
                    </HBox>

                    <!-- Table to show attendance summary -->
                    <TableView fx:id="summaryTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colStudent" text="Student"/>
                            <TableColumn fx:id="colCourse" text="Course"/>
                            <TableColumn fx:id="colPresent" text="Present"/>
                            <TableColumn fx:id="colPct" text="Raw %"/>
                            <TableColumn fx:id="colEffPct" text="Eff. %"/>
                            <TableColumn fx:id="colEligible" text="Eligible?"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 2: MEDICAL RECORDS -->
            <Tab text="Medical Records">
                <VBox spacing="10" style="-fx-padding:15;">
                    
                    <Label text="Medical Records"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                    <!-- Input form -->
                    <GridPane hgap="10" vgap="8">

                        <!-- Student ID -->
                        <Label text="Student ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="medStudentField"
                                   promptText="e.g. TG1701"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <!-- From date -->
                        <Label text="From:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <DatePicker fx:id="medFromPicker"
                                    GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <!-- To date -->
                        <Label text="To:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <DatePicker fx:id="medToPicker"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <!-- Reason -->
                        <Label text="Reason:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="medReasonField"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </GridPane>

                    <!-- Action buttons -->
                    <HBox spacing="10">
                        <Button text="Save Medical" onAction="#handleSaveMedical"/>
                        <Button text="Approve Selected" onAction="#handleApproveMedical"/>
                        <Button text="Refresh List" onAction="#handleViewMedicals"/>
                    </HBox>

                    <!-- Status -->
                    <Label fx:id="medStatusLabel"/>

                    <!-- Medical records table -->
                    <TableView fx:id="medTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMedStudent" text="Student"/>
                            <TableColumn fx:id="colMedFrom" text="From"/>
                            <TableColumn fx:id="colMedTo" text="To"/>
                            <TableColumn fx:id="colMedReason" text="Reason"/>
                            <TableColumn fx:id="colMedStatus" text="Status"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>


            <!-- TAB 3: TIMETABLE -->
            <Tab text="Department Timetable">
                <VBox spacing="10" style="-fx-padding:15;">
                    
                    <Label text="Department Timetable"/>

                    <!-- Refresh button -->
                    <Button text="Refresh Timetable"
                            onAction="#handleViewDeptTimetable"/>

                    <!-- Table -->
                    <TableView fx:id="timetableTable">
                        <columns>
                            <TableColumn fx:id="colTDay" text="Day"/>
                            <TableColumn fx:id="colTStart" text="Start"/>
                            <TableColumn fx:id="colTEnd" text="End"/>
                            <TableColumn fx:id="colTCourse" text="Course"/>
                            <TableColumn fx:id="colTVenue" text="Venue"/>
                            <TableColumn fx:id="colTNote" text="Note"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 4: NOTICE BOARD -->
            <Tab text="Notices">
                <BorderPane>
                    <center>
                        <!-- Load another FXML file -->
                        <fx:include source="NoticeBoard.fxml"/>
                    </center>
                </BorderPane>
            </Tab>

            <!-- TAB 5: PROFILE -->
            <Tab text="My Profile">
                <VBox spacing="10" style="-fx-padding:15;">
                    
                    <Label text="Update Profile"/>

                    <!-- User details form -->
                    <GridPane hgap="10" vgap="8">

                        <Label text="Full Name:"/>
                        <TextField fx:id="profNameField"/>

                        <Label text="Email:"/>
                        <TextField fx:id="profEmailField"/>

                        <Label text="Phone:"/>
                        <TextField fx:id="profPhoneField"/>

                        <Label text="Department:"/>
                        <TextField fx:id="profDeptField"/>
                    </GridPane>

                    <!-- Update button -->
                    <Button text="Update Profile"
                            onAction="#handleUpdateProfile"/>

                    <!-- Status -->
                    <Label fx:id="profileStatusLabel"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
